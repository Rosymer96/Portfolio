# ============================================================
# Portfolio Rosa Vela - Angular 19 + yarn + GitHub Pages
# ============================================================

# --- Salida de build (se genera con `yarn ng build`, nunca se versiona) ---
/dist
/tmp
/out-tsc
/bazel-out
3rdpartylicenses.txt
prerendered-routes.json

# --- Caché de Angular CLI (entera, no solo /cache) ---
/.angular

# --- Dependencias ---
/node_modules

# --- Gestor de paquetes: el proyecto usa yarn (yarn.lock SÍ se versiona) ---
package-lock.json
npm-shrinkwrap.json
.yarn-integrity
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
testem.log
/libpeerconnection.log

# --- Variables de entorno y secretos ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.*
credentials.*

# --- Tests y cobertura ---
/coverage
/.nyc_output

# --- IDEs y editores ---
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project

# Visual Studio Code: se comparten solo los ficheros de configuración del proyecto
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# --- Varios ---
.sass-cache/
/connect.lock
/typings

# --- Ficheros del sistema operativo ---
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini